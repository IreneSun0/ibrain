filters:
  and:
    - 'note.type == "source"'
formulas:
  有快照: 'if(note.content_hash, "✓ 已保全", "✗ 无快照")'
properties:
  note.source_type:
    displayName: 来源类型
  note.reliability:
    displayName: 可靠性
  note.accessed_at:
    displayName: 访问日期
  note.primary_source:
    displayName: 一手
views:
  - type: table
    name: 全部来源
    order:
      - file.name
      - note.source_type
      - note.reliability
      - formula.有快照
      - note.accessed_at
    sort:
      - property: note.accessed_at
        direction: DESC
  - type: table
    name: 有 URL 但无快照
    filters:
      and:
        - 'note.url'
        - '!note.content_hash'
    order:
      - file.name
      - note.source_type
      - note.url
      - note.accessed_at
