filters:
  and:
    - 'file.hasProperty("status")'
    - 'note.status != "archived"'
formulas:
  证据: 'note.epistemic_status + " / " + note.confidence'
properties:
  note.status:
    displayName: 状态
  note.confidence:
    displayName: 置信度
  note.last_verified:
    displayName: 最后核实
  note.review_after:
    displayName: 复核期限
  note.importance:
    displayName: 优先级
views:
  - type: table
    name: 逾期复核
    filters:
      and:
        - 'note.review_after < now()'
    order:
      - file.name
      - note.status
      - note.review_after
      - note.importance
    sort:
      - property: note.review_after
        direction: ASC
  - type: table
    name: 薄弱页面
    filters:
      or:
        - 'note.confidence == "low"'
        - 'note.confidence == "unknown"'
        - 'note.status == "stub"'
        - 'note.status == "stale"'
    order:
      - file.name
      - note.status
      - note.confidence
      - note.importance
    sort:
      - property: note.importance
        direction: ASC
  - type: table
    name: 声称已核实
    filters:
      and:
        - 'note.status == "verified"'
    order:
      - file.name
      - note.last_verified
      - note.confidence
      - formula.证据
    sort:
      - property: note.last_verified
        direction: ASC
